+int ndiBXResetForRecovery(ndicapi* api,unsigned int timeout_ms,ndiBXRecoveryReset* out)
+{
+  if(!out)return NDI_BAD_REPLY;std::memset(out,0,sizeof(*out));
+#if !defined(__linux__)
+  out->error_code=NDI_BAD_COMM;return out->error_code;
+#else
+  out->start_monotonic_ns=now(CLOCK_MONOTONIC);
+  auto finishReset=[&](int code){out->done_monotonic_ns=now(CLOCK_MONOTONIC);out->error_code=code;if(api)api->ErrorCode=code;return code;};
+  if(!api||api->SerialDevice==NDI_INVALID_HANDLE||api->IsThreadedMode||timeout_ms<50||timeout_ms>10000)return finishReset(NDI_BAD_COMM);
+  api->BxCaptureSynchronization=-1;api->BxHandleCount=0;api->IsTracking=false;
+  const uint64_t deadline=out->start_monotonic_ns+uint64_t(timeout_ms)*1000000;
+  if(ndiSerialComm(api->SerialDevice,9600,"8N1",0)<0||ndiSerialFlush(api->SerialDevice,NDI_IOFLUSH)<0||ndiSerialBreak(api->SerialDevice)<0)return finishReset(NDI_BAD_COMM);
+  const char token[]="RESETBE6F\r";unsigned matched=0;
+  while(matched<10&&out->raw_length<sizeof(out->raw)&&now(CLOCK_MONOTONIC)<deadline){
+    int error=NDI_OKAY;unsigned char byte=0;
+    int n=ndiSerialReadSomeDeadline(api->SerialDevice,reinterpret_cast<char*>(&byte),1,deadline,&error);
+    if(n<=0)return finishReset(error?error:NDI_TIMEOUT);
+    out->raw[out->raw_length++]=byte;
+    matched=byte==static_cast<unsigned char>(token[matched])?matched+1:(byte=='R'?1:0);
+  }
+  if(matched!=10)return finishReset(NDI_RESET_FAIL);
+  // The whole reset token, including CRC and CR, is required. INIT/ROM/TSTART
+  // verification is still required by the caller before capture can synchronize.
+  out->verified=1;return finishReset(NDI_OKAY);
+#endif
+}
