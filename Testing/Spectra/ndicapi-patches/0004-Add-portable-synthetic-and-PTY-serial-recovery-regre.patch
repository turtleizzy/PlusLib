+++ b/Testing/Spectra/tests/test_serial_compat.py
@@ -0,0 +1,170 @@
+"""Exercise the installed NDI library against a PTY; no physical device needed."""
+
+import ctypes
+import os
+from pathlib import Path
+import pty
+import select
+import threading
+import time
+import unittest
+
+
+LIBRARY = Path(os.environ.get(
+    "NDICAPI_LIBRARY",
+    str(Path(__file__).resolve().parents[1] / "PlusBuild-bin/bin/libndicapi.so"),
+))
+LIB = ctypes.CDLL(str(LIBRARY))
+LIB.ndiSerialOpen.argtypes = [ctypes.c_char_p]
+LIB.ndiSerialClose.argtypes = [ctypes.c_int]
+LIB.ndiSerialComm.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_char_p, ctypes.c_int]
+LIB.ndiSerialTimeout.argtypes = [ctypes.c_int, ctypes.c_int]
+LIB.ndiSerialRead.argtypes = [
+    ctypes.c_int, ctypes.c_void_p, ctypes.c_int, ctypes.c_bool,
+    ctypes.POINTER(ctypes.c_int),
+]
+LIB.ndiSerialProbe.argtypes = [ctypes.c_char_p, ctypes.c_bool]
+
+
+class SerialReadTests(unittest.TestCase):
+    def setUp(self):
+        self.master, slave = pty.openpty()
+        self.fd = LIB.ndiSerialOpen(os.ttyname(slave).encode())
+        os.close(slave)
+        self.assertGreaterEqual(self.fd, 0)
+        self.assertEqual(LIB.ndiSerialComm(self.fd, 9600, b"8N1", 0), 0)
+        self.assertEqual(LIB.ndiSerialTimeout(self.fd, 200), 0)
+
+    def tearDown(self):
+        LIB.ndiSerialClose(self.fd)
+        os.close(self.master)
+
+    def receive(self, chunks, capacity, binary=False):
+        def send():
+            for chunk in chunks:
+                time.sleep(0.025)
+                os.write(self.master, chunk)
+
+        sender = threading.Thread(target=send)
+        sender.start()
+        # The extra allocation safely detects writes beyond the declared capacity.
+        buffer = ctypes.create_string_buffer(b"\xcc" * (capacity + 32))
+        error = ctypes.c_int(0)
+        count = LIB.ndiSerialRead(self.fd, buffer, capacity, binary, ctypes.byref(error))
+        sender.join()
+        self.assertEqual(buffer.raw[capacity:], b"\xcc" * 32 + b"\0")
+        return count, buffer.raw[:max(count, 0)], error.value
+
+    def test_fragmented_ascii(self):
+        count, data, _ = self.receive([b"OK", b"AYA8", b"96\r"], 32)
+        self.assertEqual((count, data), (9, b"OKAYA896\r"))
+
+    def test_fragmented_ascii_respects_capacity(self):
+        count, data, _ = self.receive([b"1234567890", b"123456789\r"], 16)
+        self.assertEqual((count, data), (16, b"1234567890123456"))
+
+    def test_fragmented_binary_header_and_body(self):
+        packet = b"\xc4\xa5\x04\x00\x11\x22abcd\x33\x44"
+        count, data, _ = self.receive([packet[:1], packet[1:3], packet[3:6], packet[6:]], 64, True)
+        self.assertEqual((count, data), (len(packet), packet))
+
+    def test_binary_declared_length_exceeds_capacity(self):
+        count, _, error = self.receive([b"\xc4\xa5\xff\xff"], 16, True)
+        self.assertEqual((count, error), (-1, 0x0201))
+
+    def test_binary_error_reply(self):
+        count, data, _ = self.receive([b"ER", b"ROR01", b"ABCD\r"], 32, True)
+        self.assertEqual((count, data), (12, b"ERROR01ABCD\r"))
+
+    def test_timeout(self):
+        count, _, _ = self.receive([], 32)
+        self.assertEqual(count, 0)
+
+
+class ProbeTests(unittest.TestCase):
+    def probe(self, reset_noise):
+        master, slave = pty.openpty()
+        path = os.ttyname(slave).encode()
+        commands = []
+        failures = []
+
+        def command():
+            result = b""
+            deadline = time.monotonic() + 2
+            while not result.endswith(b"\r"):
+                if time.monotonic() >= deadline:
+                    raise TimeoutError(f"command incomplete: {result!r}")
+                if select.select([master], [], [], 0.05)[0]:
+                    result += os.read(master, 1024)
+            commands.append(result)
+            return result
+
+        def device():
+            try:
+                if command() != b"INIT:E3A5\r":
+                    raise AssertionError(commands)
+                if reset_noise is not None:
+                    # Replay the real trace: a bad initial byte, then reset noise
+                    # before a fragmented, valid RESET frame after the break.
+                    os.write(master, b"\xf0")
+                    time.sleep(0.35)
+                    os.write(master, reset_noise)
+                    for part in [b"RESE", b"TBE6F\r"]:
+                        time.sleep(0.01)
+                        os.write(master, part)
+                    if command() != b"INIT:E3A5\r":
+                        raise AssertionError(commands)
+                os.write(master, b"OKAYA896\r")
+                if command() != b"GETINFO:Features.Firmware.Version0492\r":
+                    raise AssertionError(commands)
+                os.write(master, b"ERROR01ABCD\r")
+                if command() != b"VER:065EE\r":
+                    raise AssertionError(commands)
+                os.write(master, b"POLARIS Spectra test firmware0000\r")
+            except Exception as exc:
+                failures.append(exc)
+
+        emulator = threading.Thread(target=device)
+        emulator.start()
+        try:
+            result = LIB.ndiSerialProbe(path, False)
+            emulator.join(timeout=3)
+            self.assertFalse(emulator.is_alive())
+            self.assertEqual(result, 0, f"probe returned {result}; device errors: {failures}")
+            self.assertFalse(failures, str(failures))
+        finally:
+            emulator.join(timeout=3)
+            os.close(master)
+            os.close(slave)
+
+    def test_clean_probe(self):
+        self.probe(None)
+
+    def test_probe_with_real_reset_noise(self):
+        self.probe(bytes.fromhex("f8 f8 f8 fc fc fe ff f8 fc fe"))
+
+    def test_probe_with_noise_ending_in_carriage_return(self):
+        self.probe(b"\xff\r")
+
+    def test_probe_rejects_invalid_reset_crc(self):
+        master, slave = pty.openpty()
+
+        def device():
+            select.select([master], [], [], 2)
+            os.read(master, 1024)
+            os.write(master, b"\xf0")
+            time.sleep(0.35)
+            os.write(master, b"RESET0000\r" + b"x" * 1024)
+
+        emulator = threading.Thread(target=device)
+        emulator.start()
+        try:
+            self.assertEqual(LIB.ndiSerialProbe(os.ttyname(slave).encode(), False), 0x0201)
+        finally:
+            emulator.join(timeout=3)
+            os.close(master)
+            os.close(slave)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
