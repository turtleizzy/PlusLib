+"""Build and test only this ndicapi checkout using synthetic bytes and owned PTYs."""
+from pathlib import Path
+import os,subprocess,sys
+T=Path(__file__).resolve().parent;ROOT=T.parents[1]
+for n in ['audit','bin']:(T/n).mkdir(exist_ok=True)
+def run(args,name,env=None):
+ with (T/'audit'/name).open('w') as out:r=subprocess.run(args,env=env,cwd=T,stdout=out,stderr=subprocess.STDOUT)
+ if r.returncode:raise SystemExit('FAIL '+str(T/'audit'/name))
+ print('PASS',name,flush=True)
+run(['cmake','-S',str(ROOT),'-B',str(T/'build'),'-DCMAKE_BUILD_TYPE=Release','-DCMAKE_LIBRARY_OUTPUT_DIRECTORY='+str(T/'bin')],'configure.log')
+run(['cmake','--build',str(T/'build'),'-j','4'],'build.log')
+run(['c++','-std=c++17','-shared','-fPIC',str(T/'tests/fault_shim.cxx'),'-ldl','-pthread','-o',str(T/'bin/fault_shim.so')],'build-shim.log')
+env=dict(os.environ,NDICAPI_LIBRARY=str(T/'bin/libndicapi.so'),PYTHONDONTWRITEBYTECODE='1');env.pop('LD_PRELOAD',None);env.pop('NDICAPI_SERIAL_WRITE_DELAY_US',None)
+for name in ['test_bx_capture.py','test_serial_compat.py','test_transport_deadlines.py','test_reset_recovery.py']:run([sys.executable,'-B',str(T/'tests'/name)],name+'.log',env)
+run([sys.executable,'-B',str(T/'tests/test_serial_compat.py')],'test_serial_paced.log',dict(env,NDICAPI_SERIAL_WRITE_DELAY_US='1500'))
