@@ -0,0 +1,146 @@
+"""Offline PTY deadline and late-reply tests; subprocess deadlines bound regressions.
+
+All injected faults target only a /dev/pts endpoint. No physical serial device.
+"""
+import ctypes as C
+import fcntl
+import json
+import os
+from pathlib import Path
+import pty
+import select
+import subprocess
+import sys
+import threading
+import time
+import unittest
+from bx_fixtures import packet,tool,error_reply
+from test_bx_capture import LIB,Capture
+
+ROOT=Path(__file__).resolve().parents[1]
+LIB.ndiSerialOpen.argtypes=[C.c_char_p]
+LIB.ndiSerialClose.argtypes=[C.c_int]
+LIB.ndiSerialTimeout.argtypes=[C.c_int,C.c_int]
+LIB.ndiSerialRead.argtypes=[C.c_int,C.c_void_p,C.c_int,C.c_bool,C.POINTER(C.c_int)]
+LIB.ndiSerialWrite.argtypes=[C.c_int,C.c_char_p,C.c_int]
+LIB.ndiSerialWriteDeadline.argtypes=[C.c_int,C.c_char_p,C.c_int,C.c_uint64]
+LIB.ndiSerialProbe.argtypes=[C.c_char_p,C.c_bool]
+
+def worker(mode):
+    master,slave=pty.openpty();path=os.ttyname(slave);assert path.startswith('/dev/pts/')
+    os.environ['NDI_TEST_SERIAL_PATH']=path
+    result={'case':mode,'source':'SYNTHETIC_PTY_ONLY'}
+    if mode.startswith('generic_'):
+        fault=mode[len('generic_'):];os.environ['NDI_TEST_SERIAL_FAULT']=fault
+        fd=LIB.ndiSerialOpen(path.encode());assert fd>=0;LIB.ndiSerialTimeout(fd,100)
+        data=C.create_string_buffer(1000000);error=C.c_int(0);flags_before=fcntl.fcntl(fd,fcntl.F_GETFL)
+        if fault.startswith('read') or fault=='poll_eintr':os.write(master,b'X')
+        started=time.monotonic()
+        if fault.startswith('write') or fault in ('zero_write','blocked_write','short_write'):
+            n=1000000 if fault=='blocked_write' else 12
+            code=LIB.ndiSerialWrite(fd,b'X'*n,n)
+        else:code=LIB.ndiSerialRead(fd,data,len(data),False,C.byref(error))
+        result.update(code=code,error=error.value,elapsed=time.monotonic()-started,flags_restored=flags_before==fcntl.fcntl(fd,fcntl.F_GETFL))
+        LIB.ndiSerialClose(fd)
+    elif mode.startswith('reset_'):
+        os.environ['NDI_TEST_SERIAL_FAULT']=mode
+        def peer():
+            buf=b''
+            while not buf.endswith(b'\r'):
+                if select.select([master],[],[],1)[0]:buf+=os.read(master,1024)
+            os.write(master,b'BAD\r');time.sleep(.35);os.write(master,b'R')
+        t=threading.Thread(target=peer);t.start();started=time.monotonic()
+        code=LIB.ndiSerialProbe(path.encode(),False)
+        result.update(code=code,elapsed=time.monotonic()-started);t.join(2)
+    else:
+        api=LIB.ndiOpenSerial(path.encode());assert api
+        def capture(timeout=60):
+            reply=Capture();started=time.monotonic();code=LIB.ndiCaptureBX(api,0x080b,timeout,C.byref(reply))
+            return code,reply,time.monotonic()-started
+        if mode=='paced_deadline':
+            os.environ['NDICAPI_SERIAL_WRITE_DELAY_US']='10000'
+            code,r,elapsed=capture(50);result.update(code=code,elapsed=elapsed,bytes=r.command_wire_bytes,valid=r.valid,state=r.transport_state)
+        elif mode.startswith('capture_write_'):
+            os.environ['NDI_TEST_SERIAL_FAULT']=mode[len('capture_'):]
+            code,r,elapsed=capture();result.update(code=code,elapsed=elapsed,bytes=r.command_wire_bytes,valid=r.valid,state=r.transport_state)
+        elif mode.startswith('late_'):
+            variant=mode[len('late_'):];raw=packet([tool(frame=400,markers={0:(3,[77,88,99],0)})]);commands=[]
+            def peer():
+                command=b''
+                while not command.endswith(b'\r'):
+                    if select.select([master],[],[],1)[0]:command+=os.read(master,1024)
+                commands.append(command)
+                if variant=='partial':os.write(master,raw[:8])
+                if variant=='crc':os.write(master,raw[:-1]+bytes([raw[-1]^1]))
+                time.sleep(.13)
+                os.write(master,error_reply(1) if variant=='ascii' else (raw[8:] if variant=='partial' else raw))
+            t=threading.Thread(target=peer);t.start()
+            a,first,elapsed=capture();b,second,second_elapsed=capture();t.join(2)
+            third,third_reply,_=capture()
+            extra=os.read(master,1024) if select.select([master],[],[],.02)[0] else b''
+            result.update(first=a,second=b,third=third,elapsed=elapsed,second_elapsed=second_elapsed,
+                          first_raw=first.raw_length,second_raw=second.raw_length,second_valid=second.valid,
+                          second_bytes=second.command_wire_bytes,second_device_error=second.device_error_code,
+                          second_receive=second.receive_monotonic_ns,extra_command_hex=extra.hex(),command_count=len(commands))
+        elif mode=='recovery_first':
+            responses=[packet([tool(frame=f)]) for f in (1,9,9,8)]
+            def peer():
+                for raw in responses:
+                    buf=b''
+                    while not buf.endswith(b'\r'):
+                        if select.select([master],[],[],1)[0]:buf+=os.read(master,1024)
+                    os.write(master,raw)
+            t=threading.Thread(target=peer);t.start();rows=[]
+            for _ in responses:
+                code,r,elapsed=capture(500);rows.append({'code':code,'valid':r.valid,'decoded':r.reply_decoded,'state':r.transport_state,'verified':r.request_association_verified,'tools':r.tool_count,'frame':r.tools[0].frame_number if r.tool_count else None})
+            t.join(2);result['rows']=rows
+        LIB.ndiCloseSerial(api)
+    os.close(master);os.close(slave)
+    print(json.dumps(result))
+
+class DeadlineTests(unittest.TestCase):
+    def case(self,mode,timeout=3):
+        env=dict(os.environ,LD_PRELOAD=str(ROOT/'bin/fault_shim.so'),LD_LIBRARY_PATH=str(ROOT/'bin'))
+        p=subprocess.run([sys.executable,'-B',str(Path(__file__).resolve()),'--worker',mode],capture_output=True,text=True,env=env,timeout=timeout)
+        self.assertEqual(p.returncode,0,p.stderr)
+        value=json.loads(p.stdout)
+        if mode.startswith('generic_'):self.assertTrue(value['flags_restored'])
+        with (ROOT/'audit/deadline-cases.jsonl').open('a') as f:f.write(json.dumps(value)+'\n')
+        return value
+    def test_read_eagain_eintr_and_poll_eintr_have_whole_operation_deadlines(self):
+        for mode in ('read_eagain','read_eintr','poll_eintr'):
+            with self.subTest(mode=mode):
+                v=self.case('generic_'+mode);self.assertEqual(v['code'],0);self.assertGreaterEqual(v['elapsed'],.07);self.assertLess(v['elapsed'],.7)
+    def test_write_eagain_eintr_zero_and_real_full_pty_are_bounded(self):
+        for mode in ('write_eagain','write_eintr','zero_write','blocked_write'):
+            with self.subTest(mode=mode):
+                v=self.case('generic_'+mode);self.assertGreaterEqual(v['code'],0);self.assertLess(v['elapsed'],.7)
+                if mode=='blocked_write':self.assertLess(v['code'],1000000)
+    def test_short_writes_are_completed(self):
+        v=self.case('generic_short_write');self.assertEqual(v['code'],12)
+    def test_capture_timeout_includes_paced_write_and_retry_loops(self):
+        for mode in ('paced_deadline','capture_write_eagain','capture_write_eintr'):
