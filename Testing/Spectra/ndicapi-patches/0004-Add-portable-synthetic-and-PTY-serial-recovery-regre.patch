+++ b/Testing/Spectra/tests/test_bx_capture.py
@@ -0,0 +1,214 @@
+"""Pure decoder + isolated PTY transport tests; never opens a physical device."""
+import ctypes as C
+import os
+from pathlib import Path
+import pty
+import select
+import struct
+import threading
+import time
+import unittest
+from bx_fixtures import packet,tool,error_reply,crc16
+
+ROOT=Path(__file__).resolve().parents[1]
+LIB=C.CDLL(os.environ.get('NDICAPI_LIBRARY',str(ROOT/'bin/libndicapi.so')))
+class Marker(C.Structure):
+    _fields_=[('label_index',C.c_int),('status',C.c_int),('out_of_volume',C.c_int),('finite',C.c_int),('xyz',C.c_float*3)]
+class Tool(C.Structure):
+    _fields_=[('handle',C.c_uint),('handle_status',C.c_uint),('port_status',C.c_uint),('frame_number',C.c_uint),
+        ('frame_available',C.c_int),('pose_present',C.c_int),('additional_info_available',C.c_int),
+        ('pose',C.c_float*8),('tool_information',C.c_uint),('marker_status',C.c_ubyte*20),
+        ('marker_count',C.c_uint),('marker_identity_known',C.c_int),('markers',Marker*20),
+        ('wire_offset',C.c_uint),('wire_length',C.c_uint)]
+class Capture(C.Structure):
+    _fields_=[('valid',C.c_int),('error_code',C.c_int),('device_error_code',C.c_int),
+        ('header_crc_valid',C.c_int),('body_crc_valid',C.c_int),('error_message',C.c_char*160),
+        ('reply_flags',C.c_uint),('tool_count',C.c_uint),('system_status',C.c_uint),('raw_length',C.c_uint),('command_wire_bytes',C.c_uint),
+        ('command_start_monotonic_ns',C.c_uint64),('receive_monotonic_ns',C.c_uint64),('receive_wall_ns',C.c_uint64),('decode_done_monotonic_ns',C.c_uint64),
+        ('tools',Tool*24),('raw',C.c_ubyte*65543),('transport_state',C.c_int),('request_sent',C.c_int),('reply_decoded',C.c_int),('command_write_count_known',C.c_int),('request_association_verified',C.c_int)]
+LIB.ndiDecodeBXCapture.argtypes=[C.c_void_p,C.c_uint,C.c_uint,C.POINTER(Capture)]
+LIB.ndiOpenSerial.argtypes=[C.c_char_p];LIB.ndiOpenSerial.restype=C.c_void_p
+LIB.ndiCloseSerial.argtypes=[C.c_void_p]
+LIB.ndiCaptureBX.argtypes=[C.c_void_p,C.c_uint,C.c_uint,C.POINTER(Capture)]
+LIB.ndiGetBXTransform.argtypes=[C.c_void_p,C.c_int,C.POINTER(C.c_float)]
+LIB.ndiGetBXPortStatus.argtypes=[C.c_void_p,C.c_int]
+LIB.ndiGetBXFrame.argtypes=[C.c_void_p,C.c_int];LIB.ndiGetBXFrame.restype=C.c_ulong
+def decode(data,flags=0x080b,result=None):
+    result=result or Capture()
+    code=LIB.ndiDecodeBXCapture(data,len(data),flags,C.byref(result))
+    return code,result
+
+class DecodeTests(unittest.TestCase):
+    def test_single_measured_point_not_pose_derived(self):
+        raw=packet([tool(markers={0:(3,[1.25,2.5,-4.75],0)})])
+        code,r=decode(raw)
+        self.assertEqual(code,0);self.assertEqual(list(r.tools[0].markers[0].xyz),[1.25,2.5,-4.75])
+        self.assertEqual(list(r.tools[0].pose)[4:7],[100,200,300])
+        self.assertEqual(bytes(r.raw[:r.raw_length]),raw)
+    def test_sparse_marker_labels_A_M_T_and_nibbles(self):
+        code,r=decode(packet([tool(markers={0:(3,[1,2,3],0),12:(1,[4,5,6],0),19:(2,[7,8,9],0)})]))
+        self.assertEqual(code,0)
+        self.assertEqual([(r.tools[0].markers[i].label_index,r.tools[0].markers[i].status) for i in range(3)],[(0,3),(12,1),(19,2)])
+    def test_multi_tool_per_tool_frame_numbers(self):
+        code,r=decode(packet([tool(1,30),tool(2,31)]))
+        self.assertEqual((code,r.tool_count),(0,2));self.assertEqual([r.tools[i].frame_number for i in range(2)],[30,31])
+    def test_missing_pose_partial_visible_markers(self):
+        code,r=decode(packet([tool(status=2,markers={2:(3,[9,8,7],0)})]))
+        self.assertEqual(code,0);self.assertEqual(r.tools[0].pose_present,0);self.assertEqual(r.tools[0].marker_count,1)
+    def test_whole_tool_missing_has_no_coordinates(self):
+        code,r=decode(packet([tool(status=2)]))
+        self.assertEqual((code,r.tools[0].marker_count,r.tools[0].pose_present),(0,0,0))
+    def test_disabled_tool_has_unavailable_frame(self):
+        code,r=decode(packet([tool(status=4),tool(2,70)]))
+        self.assertEqual(code,0);self.assertEqual(r.tools[0].frame_available,0);self.assertEqual(r.tools[1].frame_number,70)
+    def test_out_of_volume_retains_measured_values(self):
+        code,r=decode(packet([tool(markers={3:(4,[1,2,3],1)},port=0x71)]))
+        self.assertEqual(code,0);self.assertEqual(r.tools[0].markers[0].out_of_volume,1)
+    def test_identity_mismatch_is_explicit_unknown(self):
+        code,r=decode(packet([tool(markers={0:(3,[1,2,3],0),1:(3,[4,5,6],0)},points=[([1,2,3],0)])]))
+        self.assertEqual(code,0);self.assertFalse(r.tools[0].marker_identity_known);self.assertEqual(r.tools[0].markers[0].label_index,-1)
+    def test_frame_zero_is_available(self):
+        code,r=decode(packet([tool(frame=0)]));self.assertEqual((code,r.tools[0].frame_number,r.tools[0].frame_available),(0,0,1))
+    def test_reply_over_2047_bytes(self):
+        raw=packet([tool(i+1,9,markers={j:(3,[i,j,1000+j],0) for j in range(20)}) for i in range(24)])
+        self.assertGreater(len(raw),2047)
+        code,r=decode(raw);self.assertEqual((code,r.tool_count,r.tools[23].marker_count),(0,24,20))
+    def test_bad_header_crc(self):
+        raw=bytearray(packet([tool()]));raw[4]^=1
+        code,r=decode(bytes(raw));self.assertEqual(code,0x100);self.assertFalse(r.valid)
+    def test_bad_body_crc(self):
+        raw=bytearray(packet([tool()]));raw[20]^=1
+        code,r=decode(bytes(raw));self.assertEqual((code,r.tool_count),(0x100,0))
+    def test_truncated_response(self):
+        code,r=decode(packet([tool()])[:-1]);self.assertEqual(code,0x201);self.assertFalse(r.valid)
+    def test_truncated_block_with_valid_crc(self):
+        raw=packet([tool()]);body=raw[6:-2][:-5];head=b'\xc4\xa5'+struct.pack('<H',len(body))
+        code,r=decode(head+struct.pack('<H',crc16(head))+body+struct.pack('<H',crc16(body)))
+        self.assertEqual(code,0x201)
+    def test_duplicate_handles_rejected(self):
+        self.assertEqual(decode(packet([tool(1),tool(1)]))[0],0x201)
+    def test_oversized_handle_count_rejected(self):
+        self.assertEqual(decode(packet([tool(i+1,status=4) for i in range(25)]))[0],0x201)
+    def test_excess_markers_rejected(self):
+        self.assertEqual(decode(packet([tool(points=[([1,2,3],0)]*21)]))[0],0x201)
+    def test_extra_trailing_data_rejected(self):
+        self.assertEqual(decode(packet([tool()],extra=b'junk'))[0],0x201)
+    def test_nonfinite_marker_not_valid(self):
+        code,r=decode(packet([tool(markers={0:(3,[float('nan'),2,3],0)})]))
+        self.assertEqual(code,0);self.assertFalse(r.tools[0].markers[0].finite)
+    def test_nonfinite_pose_fails_explicitly(self):
+        self.assertEqual(decode(packet([tool(pose=[1,0,0,0,float('nan'),0,0,0])]))[0],0x201)
+    def test_device_unsupported_response(self):
+        code,r=decode(error_reply(1));self.assertEqual((code,r.device_error_code),(1,1))
+    def test_malformed_device_error_with_valid_crc_rejected(self):
+        for body in (b'ERROR0Z',b'ERROR01X'):
+            raw=body+('%04X'%crc16(body)).encode()+b'\r'
+            code,r=decode(raw);self.assertEqual(code,0x201);self.assertFalse(r.valid)
+    def test_stray_not_implemented(self):
+        self.assertEqual(decode(packet([tool()]),0x180b)[0],0x201)
+    def test_legacy_flags_decode_pose_unchanged(self):
+        code,r=decode(packet([tool()],0x0801),0x0801)
+        self.assertEqual(code,0);self.assertEqual(list(r.tools[0].pose)[4:7],[100,200,300])
+    def test_result_is_cleared_after_failure(self):
+        r=Capture();decode(packet([tool(markers={0:(3,[1,2,3],0)})]),result=r)
+        code,r=decode(b'bad',result=r);self.assertFalse(r.valid);self.assertEqual(r.tool_count,0)
+
+class TransportTests(unittest.TestCase):
+    def setUp(self):
+        self.master,self.slave=pty.openpty();self.path=os.ttyname(self.slave)
+        assert self.path.startswith('/dev/pts/')
+        self.device=LIB.ndiOpenSerial(self.path.encode());self.assertTrue(self.device)
+        self.threads=[];self.exceptions=[];self.commands=[]
+        self.send_reply(packet([tool(frame=1)]))
+        code,first=self.capture()
+        self.assertEqual(code,0x205);self.assertEqual(first.transport_state,2)
+        self.assertFalse(first.valid);self.commands.clear();self.threads.clear()
+    def tearDown(self):
+        for t in self.threads:t.join(timeout=3)
+        LIB.ndiCloseSerial(self.device);os.close(self.master);os.close(self.slave)
+        self.assertFalse(self.exceptions,str(self.exceptions))
+    def send_reply(self,data,chunk=0,delay=0):
+        def device():
+            try:
+                command=b'';deadline=time.monotonic()+2
+                while not command.endswith(b'\r'):
+                    if time.monotonic()>deadline:raise TimeoutError(command)
+                    if select.select([self.master],[],[],0.05)[0]:command+=os.read(self.master,256)
+                self.commands.append(command)
+                if data is not None:
+                    size=chunk or max(len(data),1)
+                    for i in range(0,len(data),size):
+                        os.write(self.master,data[i:i+size])
+                        if delay:time.sleep(delay)
+            except Exception as e:self.exceptions.append(e)
+        t=threading.Thread(target=device);t.start();self.threads.append(t)
+    def capture(self,timeout=1000,flags=0x080b):
+        r=Capture();code=LIB.ndiCaptureBX(self.device,flags,timeout,C.byref(r))
+        for t in self.threads:t.join(timeout=2)
+        return code,r
+    def test_fragmented_every_byte_and_timing(self):
+        data=packet([tool(markers={0:(3,[1,2,3],0)})]);self.send_reply(data,1,0.0002)
+        code,r=self.capture();self.assertEqual(code,0);self.assertEqual(r.raw_length,len(data))
+        cmd=b'BX:080B';self.assertEqual(self.commands[0],cmd+('%04X'%crc16(cmd)).encode()+b'\r')
+        self.assertEqual(r.command_wire_bytes,12)
+        self.assertGreater(r.receive_monotonic_ns,r.command_start_monotonic_ns)
+        self.assertGreater(r.receive_wall_ns,r.receive_monotonic_ns)
+    def test_long_fragmented_reply(self):
+        data=packet([tool(i+1,markers={j:(3,[i,j,100],0) for j in range(20)}) for i in range(24)])
+        self.send_reply(data,17,0.0001);code,r=self.capture(3000)
+        self.assertEqual((code,r.tool_count),(0,24));self.assertGreater(r.raw_length,2047)
+    def test_timeout_records_no_old_points(self):
+        self.send_reply(None);code,r=self.capture(60)
+        self.assertEqual((code,r.raw_length,r.tool_count),(0x103,0,0))
+    def test_partial_timeout_keeps_actual_prefix(self):
+        self.send_reply(b'\xc4\xa5');code,r=self.capture(60)
+        self.assertEqual(code,0x103);self.assertEqual(bytes(r.raw[:r.raw_length]),b'\xc4\xa5')
+    def test_header_crc_rejects_before_body(self):
+        data=bytearray(packet([tool()]));data[4]^=1
+        self.send_reply(bytes(data));code,r=self.capture();self.assertEqual(code,0x100);self.assertEqual(r.raw_length,6)
+    def test_unsupported_device_no_fallback(self):
+        self.send_reply(error_reply(1));code,r=self.capture();self.assertEqual(code,1);self.assertEqual(len(self.commands),1)
+    def test_recovery_after_crc_error_and_reconnect(self):
+        data=bytearray(packet([tool()]));data[-1]^=1
+        self.send_reply(bytes(data));self.assertEqual(self.capture()[0],0x100)
+        old=(C.c_float*8)(*([99]*8));self.assertNotEqual(LIB.ndiGetBXTransform(self.device,1,old),0)
+        self.assertEqual(list(old),[99]*8)
+        # No second query/flush in the uncertain connection, even for a valid late reply.
+        os.write(self.master,packet([tool(frame=9,markers={0:(3,[7,8,9],0)})]))
+        code,r=self.capture();self.assertEqual(code,0x204);self.assertEqual(r.command_wire_bytes,0)
+        self.assertFalse(r.valid);self.assertEqual(r.tool_count,0)
+        LIB.ndiCloseSerial(self.device);self.device=LIB.ndiOpenSerial(self.path.encode())
+        self.send_reply(packet([tool(frame=1)]));self.assertEqual(self.capture()[0],0x205)
+        self.send_reply(packet([tool(frame=2)]));self.assertEqual(self.capture()[0],0)
+    def test_paced_writer_is_still_used(self):
+        before=os.environ.get('NDICAPI_SERIAL_WRITE_DELAY_US')
+        os.environ['NDICAPI_SERIAL_WRITE_DELAY_US']='1500'
+        try:
+            self.send_reply(packet([tool()]));code,r=self.capture()
+            self.assertEqual(code,0);self.assertGreater(r.receive_monotonic_ns-r.command_start_monotonic_ns,12_000_000)
+        finally:
+            if before is None:os.environ.pop('NDICAPI_SERIAL_WRITE_DELAY_US',None)
+            else:os.environ['NDICAPI_SERIAL_WRITE_DELAY_US']=before
+    def test_missing_pose_preserves_legacy_getter_status(self):
+        self.send_reply(packet([tool(frame=8)]));self.assertEqual(self.capture()[0],0)
+        present=(C.c_float*8)();self.assertEqual(LIB.ndiGetBXTransform(self.device,1,present),0)
+        self.assertEqual(list(present)[4:7],[100,200,300])
+        self.send_reply(packet([tool(frame=9,status=2,markers={0:(3,[7,8,9],0)})]))
+        code,r=self.capture();self.assertEqual(code,0);self.assertFalse(r.tools[0].pose_present)
+        missing=(C.c_float*8)(*([99]*8))
+        self.assertNotEqual(LIB.ndiGetBXTransform(self.device,1,missing),0)
+        # The existing getter copies its cached matrix even with MISSING status.
+        # Preserve that status-bearing legacy behavior; the NEW snapshot has no pose.
+        self.assertEqual(list(missing),list(present))
+        self.assertEqual(list(r.tools[0].pose),[0]*8)
+        self.assertEqual(list(r.tools[0].markers[0].xyz),[7,8,9])
+    def test_disabled_preserves_legacy_status_cache_but_snapshot_unavailable(self):
+        self.send_reply(packet([tool(frame=8)]));self.assertEqual(self.capture()[0],0)
+        self.send_reply(packet([tool(status=4)]));code,r=self.capture();self.assertEqual(code,0)
+        self.assertFalse(r.tools[0].frame_available);self.assertFalse(r.tools[0].pose_present)
+        self.assertEqual(r.tools[0].marker_count,0)
+        self.assertEqual(LIB.ndiGetBXPortStatus(self.device,1),0x31)
+        self.assertEqual(LIB.ndiGetBXFrame(self.device,1),8)
+        matrix=(C.c_float*8)();self.assertNotEqual(LIB.ndiGetBXTransform(self.device,1,matrix),0)
+
+if __name__=='__main__':unittest.main(verbosity=2)
