@@ -0,0 +1,34 @@
+"""Strict reset evidence tests on one owned PTY, no physical device access."""
+import ctypes as C
+import os,pty,threading,time,unittest
+from test_bx_capture import LIB,Capture
+class Reset(C.Structure):
+ _fields_=[('verified',C.c_int),('error_code',C.c_int),('raw_length',C.c_uint),('start_monotonic_ns',C.c_uint64),('done_monotonic_ns',C.c_uint64),('raw',C.c_ubyte*1024)]
+LIB.ndiBXResetForRecovery.argtypes=[C.c_void_p,C.c_uint,C.POINTER(Reset)]
+class RecoveryTests(unittest.TestCase):
+ def attempt(self,wire):
+  master,slave=pty.openpty();path=os.ttyname(slave);self.assertTrue(path.startswith('/dev/pts/'))
+  api=LIB.ndiOpenSerial(path.encode());self.assertTrue(api)
+  def peer():
+   time.sleep(.05)
+   if wire:os.write(master,wire)
+  thread=threading.Thread(target=peer);thread.start()
+  try:
+   report=Reset();start=time.monotonic();code=LIB.ndiBXResetForRecovery(api,200,C.byref(report));elapsed=time.monotonic()-start
+   reply=Capture();after=LIB.ndiCaptureBX(api,0x080b,100,C.byref(reply))
+   self.assertNotEqual(after,0);self.assertFalse(reply.valid);self.assertEqual(reply.command_wire_bytes,0)
+   self.assertLess(elapsed,.7);self.assertGreaterEqual(report.done_monotonic_ns,report.start_monotonic_ns)
+   return code,report
+  finally:thread.join();LIB.ndiCloseSerial(api);os.close(master);os.close(slave)
+ def test_full_reset_with_stale_prefix(self):
+  code,r=self.attempt(b'old-BX-bytes\rRESETBE6F\r');self.assertEqual(code,0);self.assertEqual(r.verified,1);self.assertEqual(bytes(r.raw[:r.raw_length]),b'old-BX-bytes\rRESETBE6F\r')
+ def test_wrong_crc_is_not_recovery(self):
+  code,r=self.attempt(b'RESETBE6E\r');self.assertNotEqual(code,0);self.assertFalse(r.verified)
+ def test_missing_cr_is_not_recovery(self):
+  code,r=self.attempt(b'RESETBE6F');self.assertNotEqual(code,0);self.assertFalse(r.verified)
+ def test_silence_is_not_recovery(self):
+  code,r=self.attempt(b'');self.assertNotEqual(code,0);self.assertFalse(r.verified)
+ def test_good_bx_is_not_reset_evidence(self):
+  from bx_fixtures import packet,tool
+  code,r=self.attempt(packet([tool()]));self.assertNotEqual(code,0);self.assertFalse(r.verified)
+if __name__=='__main__':unittest.main(verbosity=2)
