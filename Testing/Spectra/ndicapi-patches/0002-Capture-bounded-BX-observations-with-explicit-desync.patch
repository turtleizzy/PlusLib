diff --git a/ndicapi_bx_capture.cxx b/ndicapi_bx_capture.cxx
new file mode 100644
index 0000000..8a1494a
--- /dev/null
+++ b/ndicapi_bx_capture.cxx
@@ -0,0 +1,197 @@
+/* Local opt-in measured-marker implementation. License: see ndicapi.h. */
+#include "ndicapi_bx_capture.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <vector>
+#if defined(__linux__)
+#include <cerrno>
+#include <climits>
+#include <poll.h>
+#include <time.h>
+#include <unistd.h>
+#endif
+namespace {
+unsigned int u16(const unsigned char* p) { return unsigned(p[0]) | unsigned(p[1]) << 8; }
+unsigned int u32(const unsigned char* p) { return unsigned(p[0]) | unsigned(p[1]) << 8 | unsigned(p[2]) << 16 | unsigned(p[3]) << 24; }
+int fail(ndiBXCapture* out, int code, const char* why)
+{
+  out->valid=0; out->tool_count=0; out->error_code=code;
+  std::snprintf(out->error_message,sizeof(out->error_message),"%s",why);
+  return code;
+}
+struct Cursor {
+  const unsigned char* begin; const unsigned char* p; const unsigned char* end;
+  const unsigned char* take(unsigned n) { if (n>unsigned(end-p)) return nullptr; const auto r=p; p+=n; return r; }
+  bool f32(float& f) { const auto q=take(4); if(!q)return false; uint32_t bits=u32(q); std::memcpy(&f,&bits,4); return true; }
+};
+#if defined(__linux__)
+uint64_t now(clockid_t id) { timespec t; if(clock_gettime(id,&t))return 0; return uint64_t(t.tv_sec)*1000000000ULL+t.tv_nsec; }
+#endif
+int finish(ndicapi* api, ndiBXCapture* out, int code)
+{
+  if(code) api->BxHandleCount=0; // no stale getters after a failed opt-in request
+  api->ErrorCode=code;
+  if(code && api->ErrorCallback) api->ErrorCallback(code,const_cast<char*>(out->error_message),api->ErrorCallbackData);
+  return code;
+}
+}
+extern "C" {
+unsigned short ndiBXCaptureCRC16(const unsigned char* data,unsigned int n)
+{
+  unsigned short c=0;
+  for(unsigned i=0;i<n;++i) { c^=data[i]; for(int bit=0;bit<8;++bit)c=(c>>1)^((c&1)?0xa001:0); }
+  return c;
+}
+int ndiDecodeBXCapture(const unsigned char* wire,unsigned int length,unsigned int flags,ndiBXCapture* out)
+{
+  if(!out)return NDI_BAD_REPLY;
+  // Public decoder supports aliasing its own raw buffer.
+  std::vector<unsigned char> copy;
+  if(wire==out->raw && length<=NDI_BX_CAPTURE_MAX_WIRE) { copy.assign(wire,wire+length); wire=copy.data(); }
+  std::memset(out,0,sizeof(*out)); out->header_crc_valid=out->body_crc_valid=-1; out->reply_flags=flags;
+  if(!wire || length>NDI_BX_CAPTURE_MAX_WIRE) return fail(out,NDI_BAD_REPLY,"raw reply exceeds capture capacity");
+  out->raw_length=length; std::memcpy(out->raw,wire,length);
+  if(!(flags&1) || (flags&~0x080bu) || ((flags&8) && !(flags&2)))
+    return fail(out,NDI_BAD_REPLY,"unsupported capture reply flags (strays/BX2 are not implemented)");
+  if(length>=5 && !std::memcmp(wire,"ERROR",5)) {
+    if(length!=12 || wire[length-1]!='\r')return fail(out,NDI_BAD_REPLY,"invalid device error reply length");
+    unsigned crc=0,code=0;
+    for(unsigned i=length-5;i<length-1;++i) { const char ch=wire[i]; if(!((ch>='0'&&ch<='9')||(ch>='A'&&ch<='F')))return fail(out,NDI_BAD_REPLY,"invalid error CRC text"); crc=crc*16+(ch<='9'?ch-'0':ch-'A'+10); }
+    out->body_crc_valid=(ndiBXCaptureCRC16(wire,length-5)==crc);
+    if(!out->body_crc_valid)return fail(out,NDI_BAD_CRC,"device error CRC mismatch");
+    for(unsigned i=5;i<7;++i) { const char ch=wire[i]; if(!((ch>='0'&&ch<='9')||(ch>='A'&&ch<='F')))return fail(out,NDI_BAD_REPLY,"invalid device error code"); code=code*16+(ch<='9'?ch-'0':ch-'A'+10); }
+    out->device_error_code=code; out->reply_decoded=1;
+    return fail(out,code?code:NDI_BAD_REPLY,(code==1||code==7)?"device rejected marker request as unsupported/invalid":"device reported an error");
+  }
+  if(length<8 || wire[0]!=0xc4 || wire[1]!=0xa5)return fail(out,NDI_BAD_REPLY,"invalid/truncated BX header");
+  out->header_crc_valid=(ndiBXCaptureCRC16(wire,4)==u16(wire+4));
+  if(!out->header_crc_valid)return fail(out,NDI_BAD_CRC,"BX header CRC mismatch");
+  if(u16(wire+2)+8u!=length)return fail(out,NDI_BAD_REPLY,"BX wire length differs from header");
+  out->body_crc_valid=(ndiBXCaptureCRC16(wire+6,length-8)==u16(wire+length-2));
+  if(!out->body_crc_valid)return fail(out,NDI_BAD_CRC,"BX payload CRC mismatch");
+  Cursor c={wire,wire+6,wire+length-2}; const auto count=c.take(1);
+  if(!count || *count>NDI_MAX_HANDLES)return fail(out,NDI_BAD_REPLY,"BX handle count exceeds capacity");
+  const unsigned n=*count; bool handles[256]={false};
+  for(unsigned i=0;i<n;++i) {
+    auto& t=out->tools[i]; t.wire_offset=unsigned(c.p-wire);
+    const auto head=c.take(2); if(!head)return fail(out,NDI_BAD_REPLY,"truncated tool header");
+    t.handle=head[0]; t.handle_status=head[1];
+    if(!t.handle || handles[t.handle] || !(t.handle_status==1||t.handle_status==2||t.handle_status==4))
+      return fail(out,NDI_BAD_REPLY,"invalid/duplicate handle or handle status");
+    handles[t.handle]=true;
+    if(t.handle_status!=NDI_HANDLE_DISABLED) {
+      if(t.handle_status!=NDI_HANDLE_MISSING) {
+        t.pose_present=1;
+        for(float& f:t.pose)if(!c.f32(f)||!std::isfinite(f))return fail(out,NDI_BAD_REPLY,"truncated/nonfinite tool pose");
+      }
+      const auto status=c.take(8); if(!status)return fail(out,NDI_BAD_REPLY,"truncated port status/frame");
+      t.port_status=u32(status); t.frame_number=u32(status+4); t.frame_available=1; // frame 0 IS available
+      if(flags&2) {
+        const auto info=c.take(11); if(!info)return fail(out,NDI_BAD_REPLY,"truncated marker identity information");
+        t.additional_info_available=1; t.tool_information=info[0];
+        // Marker A is the low nibble of the LAST of the ten bytes (T..A).
+        for(unsigned j=0;j<20;++j)t.marker_status[j]=(info[1+9-j/2]>>((j%2)*4))&15;
+      }
+      if(flags&8) {
+        const auto num=c.take(1); if(!num || *num>20)return fail(out,NDI_BAD_REPLY,"marker count exceeds tool capacity");
+        t.marker_count=*num; const auto oov=c.take((t.marker_count+7)/8);
+        if(!oov)return fail(out,NDI_BAD_REPLY,"truncated marker out-of-volume bits");
+        unsigned visible[20],visibleCount=0;
+        for(unsigned j=0;j<20;++j)if(t.marker_status[j])visible[visibleCount++]=j;
+        t.marker_identity_known=(visibleCount==t.marker_count);
+        for(unsigned j=0;j<t.marker_count;++j) {
+          auto& m=t.markers[j]; m.label_index=t.marker_identity_known?int(visible[j]):-1;
+          m.status=t.marker_identity_known?t.marker_status[m.label_index]:-1;
+          m.out_of_volume=(oov[j/8]>>(j%8))&1; m.finite=1;
+          for(float& x:m.xyz) { if(!c.f32(x))return fail(out,NDI_BAD_REPLY,"truncated measured marker coordinates"); m.finite&=std::isfinite(x); }
+        }
+      }
+    }
+    t.wire_length=unsigned(c.p-wire)-t.wire_offset;
+  }
+  const auto status=c.take(2); if(!status || c.p!=c.end)return fail(out,NDI_BAD_REPLY,"missing system status or unexplained trailing bytes");
+  out->system_status=u16(status); out->tool_count=n; out->valid=1; out->reply_decoded=1; return NDI_OKAY;
+}
+int ndiCaptureBX(ndicapi* api,unsigned int flags,unsigned int timeout_ms,ndiBXCapture* out)
+{
+  if(!out)return NDI_BAD_REPLY;
+  std::memset(out,0,sizeof(*out)); out->header_crc_valid=out->body_crc_valid=-1; out->reply_flags=flags; out->command_write_count_known=1;
+  if(!api)return fail(out,NDI_OPEN_ERROR,"NDI device is not open");
+#if !defined(__linux__)
+  return finish(api,out,fail(out,NDI_BAD_COMM,"marker capture backend supports Linux synchronous serial only"));
+#else
+  if(api->SerialDevice==NDI_INVALID_HANDLE || api->IsThreadedMode || (flags!=0x0801 && flags!=NDI_BX_CAPTURE_FLAGS) || timeout_ms<50 || timeout_ms>60000)
+    return finish(api,out,fail(out,NDI_BAD_COMM,"marker capture requires synchronous serial, supported flags, and 50..60000 ms timeout"));
+  if(api->BxCaptureSynchronization<0) {
+    out->transport_state=NDI_BX_RECONNECT_REQUIRED;
+    return finish(api,out,fail(out,NDI_BX_CAPTURE_DESYNCHRONIZED,"BX stream desynchronized: close, reconnect and reinitialize; no request was sent"));
+  }
+  const bool firstReply=api->BxCaptureSynchronization==0;
+  char command[16]; std::snprintf(command,sizeof(command),"BX:%04X",flags);
+  unsigned n=unsigned(std::strlen(command)); unsigned crc=ndiBXCaptureCRC16(reinterpret_cast<unsigned char*>(command),n);
+  std::snprintf(command+n,sizeof(command)-n,"%04X\r",crc); n+=5;
+  const uint64_t start=now(CLOCK_MONOTONIC),deadline=start+uint64_t(timeout_ms)*1000000;
+  std::vector<unsigned char> wire(NDI_BX_CAPTURE_MAX_WIRE); unsigned have=0,want=4; int headerVerified=-1; int error=0; const char* why="";
+  // Flush is housekeeping ONLY. It is not a transaction or recovery barrier.
+  ndiSerialFlush(api->SerialDevice,NDI_IFLUSH);
+  const int sent=ndiSerialWriteDeadline(api->SerialDevice,command,n,deadline);
+  if(sent!=int(n)) { error=(now(CLOCK_MONOTONIC)>=deadline)?NDI_TIMEOUT:NDI_WRITE_ERROR; why="BX paced write failed, timed out or was short"; }
+  bool asciiError=false;
+  while(!error && have<want) {
+    uint64_t t=now(CLOCK_MONOTONIC);
+    if(t>=deadline){error=NDI_TIMEOUT;why="BX request deadline exceeded";break;}
+    int readError=NDI_OKAY;
+    const int got=ndiSerialReadSomeDeadline(api->SerialDevice,reinterpret_cast<char*>(wire.data()+have),want-have,deadline,&readError);
+    if(got<=0){error=readError;why=got==0?"BX request deadline exceeded":"BX serial read error";break;}
+    have+=unsigned(got);
+    if(have==4) {
+      if(!std::memcmp(wire.data(),"ERRO",4)){asciiError=true;want=5;}
+      else if(wire[0]==0xc4 && wire[1]==0xa5 && u16(wire.data()+2)>=3)want=6;
+      else {error=NDI_BAD_REPLY;why="BX invalid serial header";}
+    }
+    if(asciiError && have==want) {
+      if(have>=6 && wire[have-1]=='\r')break;
+      if(have>=256){error=NDI_BAD_REPLY;why="oversize device error reply";break;}
+      want=have+1;
+    } else if(have==6 && !asciiError) {
+      headerVerified=(ndiBXCaptureCRC16(wire.data(),4)==u16(wire.data()+4));
+      if(!headerVerified){error=NDI_BAD_CRC;why="BX header CRC mismatch";break;}
+      want=u16(wire.data()+2)+8;
+    }
+  }
+  const uint64_t receive=now(CLOCK_MONOTONIC),wall=now(CLOCK_REALTIME);
+  if(error) { out->raw_length=have;out->header_crc_valid=headerVerified;std::memcpy(out->raw,wire.data(),have);fail(out,error,why); }
+  else error=ndiDecodeBXCapture(wire.data(),have,flags,out);
+  out->command_write_count_known=sent>=0;
+  out->command_wire_bytes=sent>0?unsigned(sent):0; out->request_sent=sent==int(n);
+  out->command_start_monotonic_ns=start;
+  out->receive_monotonic_ns=receive; out->receive_wall_ns=wall; out->decode_done_monotonic_ns=now(CLOCK_MONOTONIC);
+  if(!error && now(CLOCK_MONOTONIC)>=deadline) error=fail(out,NDI_TIMEOUT,"BX decode completed after request deadline");
+  if(!error && firstReply) {
+    // Reopening cannot prove the absence of delayed bytes. Do not publish the
+    // first reply, and do not claim that discarding it eliminates all ambiguity.
+    api->BxCaptureSynchronization=1;
+    out->transport_state=NDI_BX_FIRST_REPLY_QUARANTINED;
+    error=fail(out,NDI_BX_CAPTURE_RECOVERY_REPLY,"first BX reply quarantined; later association assumes serialized protocol order, not a transaction ID");
+  } else if(error) {
+    api->BxCaptureSynchronization=-1;
+    out->transport_state=NDI_BX_RECONNECT_REQUIRED;
+  } else {
+    api->BxCaptureSynchronization=1;
+    out->transport_state=NDI_BX_ORDERED_UNVERIFIED;
+  }
+  if(!error) {
+    api->BxHandleCount=out->tool_count; api->BxReplyLength=static_cast<unsigned short>(have-8); api->BxSystemStatus=out->system_status;
+    for(unsigned i=0;i<out->tool_count;++i) {
+      const auto& t=out->tools[i]; api->BxHandles[i]=char(t.handle);api->BxHandlesStatus[i]=char(t.handle_status);
+      if(t.frame_available) { api->BxPortStatus[i]=int(t.port_status);api->BxFrameNumber[i]=t.frame_number; }
+      if(t.pose_present) std::memcpy(api->BxTransforms[i],t.pose,sizeof(t.pose)); // preserve legacy invalid-pose behavior
+    }
+  }
+  return finish(api,out,error);
+#endif
+}
+}
diff --git a/ndicapi_bx_capture.h b/ndicapi_bx_capture.h
new file mode 100644
index 0000000..5eb8d5d
--- /dev/null
+++ b/ndicapi_bx_capture.h
@@ -0,0 +1,64 @@
+/* Local opt-in BX measured-marker capture, 2026-10-26.
+ * Uses the ndicapi license in ndicapi.h. No ROM-derived coordinates. */
+#ifndef NDICAPI_BX_CAPTURE_H
+#define NDICAPI_BX_CAPTURE_H
+#include "ndicapi.h"
+#include <stdint.h>
+#define NDI_BX_CAPTURE_MAX_WIRE 65543u
+#define NDI_BX_CAPTURE_FLAGS 0x080Bu
+#define NDI_BX_CAPTURE_DESYNCHRONIZED 0x0204
+#define NDI_BX_CAPTURE_RECOVERY_REPLY 0x0205
+enum { NDI_BX_DECODER_ONLY=0, NDI_BX_ORDERED_UNVERIFIED=1, NDI_BX_FIRST_REPLY_QUARANTINED=2, NDI_BX_RECONNECT_REQUIRED=3 };
+struct ndiBXCapturedMarker
+{
+  int label_index; /* 0=A..19=T, -1 when identity cannot be matched */
+  int status;      /* 0..5 device nibble; -1 if unavailable */
+  int out_of_volume;
+  int finite;
+  float xyz[3];
+};
+struct ndiBXCapturedTool
+{
+  unsigned int handle, handle_status, port_status, frame_number;
+  int frame_available, pose_present, additional_info_available;
+  float pose[8]; /* q0,qx,qy,qz,tx,ty,tz,fit error: all from this reply */
+  unsigned int tool_information;
+  unsigned char marker_status[20]; /* A..T; zero = missing OR not defined */
+  unsigned int marker_count;
+  int marker_identity_known;
+  ndiBXCapturedMarker markers[20];
+  unsigned int wire_offset, wire_length;
+};
+struct ndiBXCapture
+{
+  int valid, error_code, device_error_code, header_crc_valid, body_crc_valid;
+  char error_message[160];
+  unsigned int reply_flags, tool_count, system_status, raw_length, command_wire_bytes;
+  uint64_t command_start_monotonic_ns, receive_monotonic_ns, receive_wall_ns, decode_done_monotonic_ns;
+  ndiBXCapturedTool tools[NDI_MAX_HANDLES];
+  unsigned char raw[NDI_BX_CAPTURE_MAX_WIRE];
+  int transport_state, request_sent, reply_decoded;
+  int command_write_count_known;
+  // Always false: BX has no transaction identifier. CRC/counters cannot prove association.
+  int request_association_verified;
+};
+#ifdef __cplusplus
+extern "C" {
+#endif
+ndicapiExport unsigned short ndiBXCaptureCRC16(const unsigned char* data, unsigned int length);
+/* Pure bounded decoder; raw wire includes independent header and payload CRCs. */
+ndicapiExport int ndiDecodeBXCapture(const unsigned char* wire, unsigned int length,
+                                   unsigned int flags, ndiBXCapture* result);
+/* One atomic serial request. Caller must hold its existing command lock.
+ * Linux, synchronous serial only. Does not change baud, timeout termios, or rate.
+ * Uses one absolute monotonic deadline for nonblocking paced write and fragmented read.
+ * Any request failure latches reconnect-required; later calls send/flush nothing.
+ * First decoded reply on each newly opened connection is quarantined, never published.
+ * Subsequent association is an explicit serial-order assumption, not proof of freshness.
+ * Only an accepted reply populates legacy BX pose/status getters. */
+ndicapiExport int ndiCaptureBX(ndicapi* api, unsigned int flags, unsigned int timeout_ms,
+                             ndiBXCapture* result);
+#ifdef __cplusplus
+}
+#endif
+#endif
